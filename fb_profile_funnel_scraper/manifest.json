{
  "manifest_version": 3,
  "name": "FB Profile Funnel Scraper",
  "version": "1.1",
  "description": "Cào phễu 3 bước: Lấy Avatar, Cover, Quét bài đăng, Chấm điểm hoạt động cho Breeders, duyệt Website và kết nối trực tiếp sang Web Dashboard.",
  "permissions": [
    "activeTab",
    "<all_urls>",
    "storage",
    "unlimitedStorage",
    "scripting",
    "downloads",
    "tabs",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.gooddog.com/*",
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "nlp_extractor.onnx",
        "vocab.json",
        "exceljs.min.js"
      ],
      "matches": ["*://*.facebook.com/*", "<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:8000/*",
      "http://localhost:8000/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  }
}
